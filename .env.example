# Copy to /etc/tencent-lighthouse-traffic-guard.env and chmod 600.
TENCENTCLOUD_SECRET_ID=replace-with-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-secret-key
TENCENTCLOUD_REGION=ap-guangzhou
TENCENTCLOUD_INSTANCE_ID=lhins-xxxxxxxx
# For multiple regions, use this instead of the two variables above:
# TENCENTCLOUD_TARGETS=ap-seoul=lhins-seoul-1,lhins-seoul-2;ap-guangzhou=lhins-gz-1
# Use "all" to monitor every instance with a traffic package in that region:
# TENCENTCLOUD_TARGETS=ap-seoul=all;ap-guangzhou=all
# Use "*=all" to monitor every instance in every available Lighthouse region:
# TENCENTCLOUD_TARGETS=*=all
# TENCENTCLOUD_REGION=*          # "all" works too
# TENCENTCLOUD_INSTANCE_ID=all
TRAFFIC_THRESHOLD_PERCENT=95
